  if (it) {
    if (reimageSelect)   reimageSelect.value   = it.reimage ?? '';
    if (forensicsSelect) forensicsSelect.value = it.forensics ?? '';
    if (irCapacitySelect) irCapacitySelect.value = it.irCapacity ?? '';
  }
  const ctx = loadContext();
  if (ctx && contextForm) {
    const regulatoryChecks = contextForm.querySelectorAll<HTMLInputElement>('input[name="regulatory"]');
    const industryChecks   = contextForm.querySelectorAll<HTMLInputElement>('input[name="industry-specific"]');
    const voluntaryChecks  = contextForm.querySelectorAll<HTMLInputElement>('input[name="voluntary"]');
    setCheckedValues(regulatoryChecks, ctx.regulatory ?? []);
    setCheckedValues(industryChecks,   ctx.industry   ?? []);
    setCheckedValues(voluntaryChecks,  ctx.voluntary  ?? []);
  }
  markInvalidStyles();

  // Falls schon eine Tactic steht, gleich berechnen
  if (tacticInput && tacticInput.value.trim()) {
    updateActionsDisplay(tacticInput.value.trim());
  }
})();

// NEU: Hilfsfunktion, die den Text für die Zwischenablage inklusive der Zeitstempel erstellt.
function getActionsTextForClipboard(actionsListContent: HTMLDivElement): string {
  const lines: string[] = [];
  const olElement = actionsListContent.querySelector('ol');
  if (!olElement) return '';

  // Geht alle direkten Kinder der Liste durch (<li>, <br>, <hr>)
  Array.from(olElement.children).forEach((child, index) => {
    if (child.tagName === 'LI') {
      const li = child as HTMLLIElement;
      const contentWrapper = li.querySelector('.measure-content-wrapper');

      if (contentWrapper) {
        // Dies ist ein Standard-Maßnahmenpunkt mit Zeitstempel
        const timestampInput = contentWrapper.querySelector('input.timestamp-input') as HTMLInputElement;
        const measureTextSpan = contentWrapper.querySelector('span');

        const timestamp = timestampInput?.value ? `[${timestampInput.value}]` : '[NO_TIMESTAMP]';
        const measureText = measureTextSpan ? measureTextSpan.innerText.trim() : '';
        
        // Nummerierung manuell hinzufügen, da li.value nicht immer zuverlässig ist
        const itemNumber = olElement.querySelectorAll('li > .measure-content-wrapper').length > 0 ? `${index + 1}.` : '';

        lines.push(`${itemNumber} ${timestamp} ${measureText}`.trim());

        // Prüft auf Unterlisten (z.B. bei Meldepflichten)
        const sublist = li.querySelector('ul');
        if (sublist) {
          Array.from(sublist.children).forEach(subLiChild => {
            lines.push(`    - ${subLiChild.textContent?.trim()}`); // Eingerückte Unterpunkte
          });
        }
      } else if (li.textContent?.trim()) {
        // Behandelt andere Listenelemente wie Header (z.B. "Recovery Path")
        lines.push(li.textContent.trim());
      }
    } else if (child.tagName === 'BR') {
      lines.push(''); // Fügt eine Leerzeile für <br> hinzu
    } else if (child.tagName === 'HR') {
      lines.push('---'); // Fügt einen Trenner für <hr> hinzu
    }
  });

  // Fügt die gesetzlichen Fristen hinzu, falls vorhanden
  const deadlinesContainer = document.getElementById('reporting-deadlines');
  if (deadlinesContainer && deadlinesContainer.innerText.trim()) {
    lines.push('\n--- Legal Deadlines for Reporting Obligations ---\n' + deadlinesContainer.innerText.trim());
  }

  return lines.join('\n');
}

