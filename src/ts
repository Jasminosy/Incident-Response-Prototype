// ---------- 9) Anzeige-Logik ----------
function updateActionsDisplay(tacticId: string) { // Changed to accept tacticId
  if (!actionsDisplay) return;

  // Clear and re-create the structure including the copy button and feedback
  actionsDisplay.innerHTML = `
    <div class="actions-header">
      <h3>Recommended Actions</h3>
      <div class="copy-controls">
        <button id="copy-actions-btn" class="copy-btn" title="Copy all actions to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2v2"/></svg>
        </button>
        <span id="actions-copy-feedback" class="copy-feedback"></span>
      </div>
    </div>
    <div id="actions-list-content"></div>
  `;

  const actionsListContent = actionsDisplay.querySelector('#actions-list-content') as HTMLDivElement;
  if (!actionsListContent) return;
  
  // Pflicht: beide IT-Felder gesetzt
  if (!isContextInfoValid()) { // isContextInfoValid prüft reimageSelect und forensicsSelect
    actionsDisplay.innerHTML = '<p class="error">Please set all IT Dependencies (Reimage, Forensics, Capacities).</p>';
    return;
  }

  // Add event listener for the copy button AFTER the content is rendered
  const copyBtn = actionsDisplay.querySelector('#copy-actions-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      // MODIFIZIERT: Ruft die neue Funktion auf, um den Text zu generieren.
      const textToCopy = getActionsTextForClipboard(actionsListContent);
      copyToClipboard(textToCopy, 'actions-copy-feedback');
    });
  }

  // Tactic ermitteln (+ Parent-Fallback für Untertaktiken)
  let actionIds = tacticToActionMap[tacticId];
  if (!actionIds && tacticId.includes('.')) {
    actionIds = tacticToActionMap[tacticId.split('.')[0]];
  }

  if (!actionIds || !actionIds.length) {
    actionsListContent.innerHTML = '<p>No recommended actions found for this tactic.</p>';
    return;
  }

  // Kopie für die Bearbeitung erstellen
  let current = [...actionIds];

  // Flag, ob ursprünglich PFM-Maßnahmen vorhanden waren (für die M009-Logik)
  const hasPfmMeasuresInitially = actionIds.some(id => id.startsWith('PFM'));

  // --- LOGIK FÜR FORENSIK-MAẞNAHMEN ---
  const forensicsKnowHow = forensicsSelect?.value;
  if (forensicsKnowHow === 'basicforensics') {
    current = current.filter(id => !id.startsWith('PFM')); // PFM ausfiltern
  } else if (forensicsKnowHow === 'noforensics') {
    current = current.filter(id => !id.startsWith('PFM') && !id.startsWith('BFM')); // Beide ausfiltern
  }

  // Reimage nur im Notfall - hier wird definiert bei welchen Angriffsarten ein Notfall vorliegt
  const isReimageException = false; // Temporär deaktiviert, um die Logik zu korrigieren.

  // Sonderregel A: Reimage NUR IN NOTFALL (local) → wenn M005 vorhanden, ersetze/erweitere wie gehabt
  // Diese Regel wird nicht angewendet, wenn die Taktik eine Ausnahme ist.
  if (current.includes('M005') && reimageSelect?.value === REIMAGE_ONLY_EMERGENCY) {
    if (isReimageException) {
      // NEU: Bei Ausnahme-Taktiken, füge M022 (backup) vor M005 (reimage) ein.
      const m005Index = current.indexOf('M005');
      if (m005Index > -1 && !current.includes('M022')) {
        current.splice(m005Index, 0, 'M022');
      }
    } else {
    // Reimage Client(s) entfernen und durch alternative Maßnahmen ersetzen.
    current = current.filter(id => id !== 'M005');
    ['M025','M047','M010'].forEach(add => { if (!current.includes(add)) current.push(add); });
  }
  }


  // NEU: Sonderregel für IR-Kapazitäten. Wenn nur für das Wichtigste, filtere gegen eine Whitelist.
  if (irCapacitySelect?.value === 'important_only') {
    const whitelist = new Set([
        'IM001', 'IM012', 'IM017', 'IM029', 'IM033', 'IM021', 
        'BFM016', 'BFM019', 'BFM028', 'BFM025', 
        'M001', 'M002', 'M003', 'M007', 'M010', 'M017', 'M026', 'M045', 'M009', 'M024', 
        'M030', 'M033', 'M034', 'M035', 'M036', 'M043', 'M046', 'M047', 'M048', 
        'M050', 'M051', 'M052', 'M053', 'M054', 'M055', 'M022'
    ]);
    current = current.filter(id => whitelist.has(id));
  }

  // KORREKTUR: Sicherstellen, dass M024 immer vor IM033 kommt.
  // Da M024 nur durch Logik hinzugefügt wird, fügen wir es hier explizit hinzu, falls IM033 vorhanden ist.
  const im033Index = current.indexOf('IM033');
  if (im033Index > -1) {
    const m024Index = current.indexOf('M024');
    if (m024Index === -1) { // Wenn M024 noch nicht da ist
      current.splice(im033Index, 0, 'M024'); // M024 direkt vor IM033 einfügen
    }
  }

  // Schrittweise Ausgabe starten
  const olElement = document.createElement('ol');
  actionsListContent.appendChild(olElement);
  renderMeasuresStepwise(current, hasPfmMeasuresInitially, olElement); // hasPfmMeasuresInitially übergeben
}

